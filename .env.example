# Copy to .env for local testing. On Render, set these as environment variables instead.

# Dashboard login password (you choose this)
DASHBOARD_PASSWORD=changeme
SESSION_SECRET=change-this-to-a-random-string

# Meta / WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=your_system_user_permanent_token
WHATSAPP_PHONE_NUMBER_ID=1362380576960975
WHATSAPP_WABA_ID=1460434966063007
WHATSAPP_API_VERSION=v21.0

# Must match the Verify Token you set in Meta App > WhatsApp > Configuration > Webhooks
WHATSAPP_WEBHOOK_VERIFY_TOKEN=changeme-verify-token

# Postgres connection string from Render (leave unset to use local SQLite file)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
